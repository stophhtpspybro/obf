if shared.iscodea then return end
shared.iscodea = true

local Codes = {
    "HALLOWEEN2026",
    "DEATH"
}

local HttpService = game:GetService("HttpService")
local MainRemoteFunction = game:GetService("ReplicatedStorage"):WaitForChild("RemoteFunctions"):WaitForChild("MainRemoteFunction")
local userId = tostring(game.Players.LocalPlayer.UserId)
local SAVE_FILE = "SmellLikeHacker_RedeemedCodes.json"

local saved = {}
pcall(function()
    if isfile and isfile(SAVE_FILE) then
        saved = HttpService:JSONDecode(readfile(SAVE_FILE))
    end
end)
saved[userId] = saved[userId] or {}
local done = saved[userId]
local function save()
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, HttpService:JSONEncode(saved))
        end
    end)
end

local function levelReq(response)
    return tonumber(tostring(response):match("Must be Level (%d+)"))
end
local function myLevel()
    local ok, lvl = pcall(function()
        return game.Players.LocalPlayer.leaderstats.Level.Value
    end)
    return ok and tonumber(lvl) or 0
end
local FAVORITE_MSG = "Like and Favorite the game to redeem this code"
local favoriteBlocked = false
local function pending(code)
    local response = done[code]
    if not response then
        return true
    end
    if response == FAVORITE_MSG then
        return not favoriteBlocked
    end
    local req = levelReq(response)
    return req ~= nil and myLevel() >= req
end

local list, seen = {}, {}
local function add(code)
    code = tostring(code)
    if code ~= "" and code ~= "LOCKED" and not seen[code] then
        seen[code] = true
        table.insert(list, code)
    end
end
pcall(function()
    for _, v in ipairs(workspace.Leaderboards.MilestoneBoard.Center.Surface.ScrollingFrame:GetChildren()) do
        if v:IsA("Frame") and v:FindFirstChild("MilestoneCode") then
            add(v.MilestoneCode.Text)
        end
    end
end)
for _, code in ipairs(Codes) do
    add(code)
end
for code, response in pairs(done) do
    if levelReq(response) or response == FAVORITE_MSG then
        add(code)
    end
end

local lastAccepted = -math.huge
for _, code in ipairs(list) do
    if pending(code) then
        local started, response = os.clock(), nil
        repeat
            local sentAt = os.clock()
            local ok, res = pcall(function()
                return MainRemoteFunction:InvokeServer("RedeemPromoCode", code)
            end)
            if ok and type(res) == "table" and res.response then
                response, lastAccepted = tostring(res.response), sentAt
            else
                task.wait(math.max(0.15, lastAccepted + 2.95 - os.clock()))
            end
        until response or os.clock() - started > 8
        if not response then
            break
        end
        if response == FAVORITE_MSG then
            favoriteBlocked = true
        end
        done[code] = response
        save()
        print("[RedeemCode] " .. code .. ": " .. response)
    end
end
